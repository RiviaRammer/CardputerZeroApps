#!/usr/bin/python3 -I
"""Relay a sudo password prompt over the app's private, local Unix socket."""

import os
import socket
import sys


def main():
    path = os.environ.get("WALLPAPER_ASKPASS_SOCKET")
    if not path:
        return 1
    try:
        with socket.socket(socket.AF_UNIX) as connection:
            connection.settimeout(120)
            connection.connect(path)
            with connection.makefile("rb") as stream:
                reply = stream.readline(257)
        if not reply.endswith(b"\n") or len(reply) > 256:
            return 1
        sys.stdout.buffer.write(reply)
    except OSError:
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
