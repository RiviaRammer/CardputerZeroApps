#!/usr/bin/python3 -I
"""Install a single fixed asset from raw pixels or PCM on standard input."""

import fcntl
from io import BytesIO
import os
from pathlib import Path
import stat
import subprocess
import sys
import tempfile

# Isolated mode ignores the invoking user's environment and Python packages.
sys.path.insert(0, "/usr/lib/wallpaper")

from PIL import Image

from assets import (
    ASSETS, BOOT, DROP_IN, DROP_IN_CONTENT, LEGACY_DROP_IN_CONTENT, PCM_LIMIT,
    WRITER_READY, valid_pcm, write_wav,
)
from build_splash import build_images
from current import configured_linux_splash


def read_regular(path, limit):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as source:
        if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
            raise ValueError(f"Expected a regular file: {path}")
        data = source.read(limit + 1)
    if len(data) > limit:
        raise ValueError(f"Existing file is too large: {path}")
    return data


def replace_file(path, data):
    fd, temp_name = tempfile.mkstemp(prefix=".boot-assets-", dir=path.parent)
    temp = Path(temp_name)
    try:
        with os.fdopen(fd, "wb") as output:
            # FAT derives file modes from its mount options.
            if path.parent != BOOT:
                os.fchmod(output.fileno(), 0o644)
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        temp.replace(path)
    finally:
        temp.unlink(missing_ok=True)


def encode_asset(target, data):
    asset = ASSETS[target]
    with BytesIO() as output:
        if target == "sound":
            if not valid_pcm(data):
                raise ValueError("Invalid PCM size")
            write_wav(output, data)
        else:
            if len(data) != asset.payload_size:
                raise ValueError("Invalid RGB pixel count")
            image = Image.frombytes("RGB", asset.size, data)
            if target in ("firmware", "linux"):
                firmware, bmp = build_images(image.transpose(Image.Transpose.ROTATE_90))
                return firmware if target == "firmware" else bmp
            image.save(output, format="PNG")
        return output.getvalue()


def install_asset(target, data):
    dest = ASSETS[target].destination
    if dest.parent == BOOT and not BOOT.is_mount():
        raise ValueError(f"Boot partition is not mounted: {BOOT}")
    encoded = encode_asset(target, data)

    update_drop_in = False
    if target == "linux" and configured_linux_splash() != dest:
        if not os.access("/usr/sbin/fb_load", os.X_OK):
            raise ValueError("fb_load is missing: /usr/sbin/fb_load")
        try:
            config = read_regular(DROP_IN, 4096).strip()
            if config == LEGACY_DROP_IN_CONTENT.strip():
                update_drop_in = True
            elif config != DROP_IN_CONTENT.strip():
                raise ValueError(f"Existing fb_load override differs: {DROP_IN}")
        except FileNotFoundError:
            DROP_IN.parent.mkdir(mode=0o755, exist_ok=True)
            update_drop_in = True

    if not stat.S_ISREG(dest.stat(follow_symlinks=False).st_mode):
        raise ValueError(f"Expected a regular file: {dest}")

    replace_file(dest, encoded)
    if update_drop_in:
        try:
            replace_file(DROP_IN, DROP_IN_CONTENT)
        except OSError as error:
            raise ValueError(f"BMP saved, but fb_load override failed: {error}") from error
    if update_drop_in:
        try:
            subprocess.run(["/usr/bin/systemctl", "daemon-reload"], check=True, timeout=15)
        except (OSError, subprocess.SubprocessError) as error:
            raise ValueError(f"BMP and override saved. Reload systemd or reboot: {error}") from error
        if configured_linux_splash() != dest:
            raise ValueError(f"BMP saved, but another fb_load setting takes precedence: {dest}")


def read_batch(stream):
    batch = {}
    while header := stream.readline(40):
        target, separator, length = header.rstrip(b"\n").partition(b" ")
        key = target.decode("ascii")
        if (not header.endswith(b"\n") or not separator or not length.isdigit()
                or key not in ASSETS or key in batch):
            raise ValueError("Invalid asset bundle")
        size = int(length)
        asset = ASSETS[key]
        if asset.size and size != asset.payload_size:
            raise ValueError(f"Invalid RGB size: {key}")
        if not asset.size and (not 0 < size <= PCM_LIMIT or size % 4):
            raise ValueError(f"Invalid PCM size: {key}")
        data = stream.read(size)
        if len(data) != size:
            raise ValueError(f"Incomplete asset: {key}")
        batch[key] = data
    if not batch:
        raise ValueError("No assets to install")
    return batch


def main():
    if os.geteuid() != 0 or sys.argv[1:] != ["batch"]:
        return 2
    completed = []
    try:
        batch = read_batch(sys.stdin.buffer)
        with open("/run/wallpaper.lock", "wb") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            sys.stdout.buffer.write(WRITER_READY)
            sys.stdout.buffer.flush()
            for target, payload in batch.items():
                install_asset(target, payload)
                completed.append(ASSETS[target].title)
    except (OSError, ValueError) as error:
        print(error, file=sys.stderr)
        if completed:
            print("已写入 " + "、".join(completed), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
